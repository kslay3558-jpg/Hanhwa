rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /posts/{postId} {

      // 1. 누구나 읽기 가능
      allow read: if true;

      // 2. 로그인 없이 글쓰기 허용 (비밀번호 필드 포함)
      allow create: if
        request.resource.data.keys().hasAll(['title', 'content', 'authorId', 'createdAt', 'password'])
        && request.resource.data.keys().hasOnly(['title', 'content', 'authorId', 'createdAt', 'password'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && request.resource.data.authorId is string
        && request.resource.data.authorId.size() > 0
        && request.resource.data.password is string
        && request.resource.data.password.size() >= 4;  // 최소 4자리 비밀번호

      // 3. 수정: 비밀번호 필드 유지 허용 (내용만 변경)
      allow update: if
        request.resource.data.keys().hasOnly(['title', 'content', 'authorId', 'createdAt', 'password'])
        && request.resource.data.password == resource.data.password; // 기존 비번 일치해야 수정

      // 4. 삭제: 클라이언트에서 비밀번호 확인 후 삭제 (규칙에서 비밀번호 직접 비교 불가)
      allow delete: if true;
    }

  }
}
