rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /comments/{commentId} {

      // 1. 누구나 댓글 읽기 가능
      allow read: if true;

      // 2. 로그인 없이 댓글 작성 허용 (필드 유효성 검증)
      allow create: if
        // 필수 필드(닉네임, 내용, 삭제용 비밀번호, 작성일)가 모두 있어야 함
        request.resource.data.keys().hasAll(['nick', 'content', 'pw', 'date'])
        // 허용된 필드 외의 데이터 삽입 차단
        && request.resource.data.keys().hasOnly(['nick', 'content', 'pw', 'date'])
        // 닉네임: 문자열, 1자 이상 30자 이하
        && request.resource.data.nick is string
        && request.resource.data.nick.size() > 0
        && request.resource.data.nick.size() <= 30
        // 내용: 문자열, 1자 이상 500자 이하
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500
        // 비밀번호: 문자열, 1자 이상 30자 이하
        && request.resource.data.pw is string
        && request.resource.data.pw.size() > 0
        && request.resource.data.pw.size() <= 30
        // 작성일: 문자열 (ISO 8601)
        && request.resource.data.date is string
        && request.resource.data.date.size() > 0;

      // 3. 댓글 수정 불가 (앱에서 수정 기능 없음)
      allow update: if false;

      // 4. 삭제는 앱 레벨에서 비밀번호 검증 후 허용
      //    Firestore Rules에서 요청 비밀번호를 직접 검사할 수 없으므로
      //    클라이언트 코드(Board.deleteComment)에서 비밀번호 일치 확인 후 삭제
      allow delete: if true;
    }

  }
}
